# ============================================================
# Incident Intelligence Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# Rename: cp .env.example .env

# ---- LLM Provider ----
# Options: "groq" (free, fast, cloud) or "ollama" (fully local)
LLM_PROVIDER=groq

# ---- Groq (Free tier - get key at https://console.groq.com) ----
GROQ_API_KEY= your api key here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Ollama (if running locally - install from https://ollama.com) ----
# Pull a model first: `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings ----
# HuggingFace sentence-transformers (runs locally, free, no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Persistence Paths ----
CHROMA_DB_PATH=./data/chroma_db
SQLITE_DB_PATH=./data/incidents.db
UPLOAD_DIR=./data/uploads
